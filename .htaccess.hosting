# .htaccess para HOSPEDAGEM (raiz do htdocs)
# Na hospedagem gratuita, renomeie para .htaccess ou copie o ErrorDocument abaixo.

# Desabilitar listagem de diretórios
Options -Indexes

# Proteger arquivos sensíveis
<FilesMatch "^(database\.(php|example\.php|hosting\.example\.php)|\.env)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^templates/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>

AddDefaultCharset UTF-8
DirectoryIndex index.php

# 404 na raiz (hospedagem — SEM /DreamyCookies/)
ErrorDocument 404 /404.php
